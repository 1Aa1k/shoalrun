.venv/
data/stack.npz
data/lake_raw.json
__pycache__/

# Annotator chips: ~190 MB of rendered JPEG, regenerable from build_annotator.py
dist/annotate/chips/
# Per-pixel evidence grids: 1.5 GB, regenerable from detect_edge.py
data/evidence/
# Derived bathymetry grids: ~357 MB, regenerable from derive_bathymetry.py
data/sdb/*.npy

# Scratch preview builds. These are full 2.4 MB copies of dist/index.html with
# a default flipped so a screenshot can reach a state that needs a click. They
# are throwaway, and 4.8 MB of them once made it into a commit.
dist/_*.html
